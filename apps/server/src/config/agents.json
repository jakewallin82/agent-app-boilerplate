      "isolation": "shared",
      "fileLoading": {
        "sharedFiles": "copy-on-start",
        "includePatterns": ["predictions/**", "reflections/**", "research/**"]
      },
      "security": {
        "network": "full",
        "allowedTools": ["Bash", "Read", "Write", "Edit", "Glob", "Grep", "WebSearch", "WebFetch", "Task", "TaskOutput", "TodoWrite", "AskUserQuestion", "Skill"]
      },
      "startup": {
