        "network": "none",
        "allowedTools": ["Read", "Glob", "Grep", "TodoWrite", "AskUserQuestion"]
      },
      "startup": {
        "strategy": "pre-warm-on-login",
        "warmupTTL": 300
      },
      "canWriteShared": false
    },
